# Copy to .env for local work. Never commit real keys.
# Search key must be the scoped search only key, never admin.
NUXT_PUBLIC_SEARCH_HOST=
NUXT_PUBLIC_SEARCH_PORT=443
NUXT_PUBLIC_SEARCH_PROTOCOL=https
NUXT_PUBLIC_SEARCH_KEY=
NUXT_PUBLIC_SEARCH_COLLECTION=jobs

# Server-side Typesense key used to index employer jobs. Never expose it.
TYPESENSE_ADMIN_KEY=

# Neon. `neon env pull` fills DATABASE_URL and NEON_* for the linked branch.
# Use a dev branch locally; the production URL belongs in the deploy env, not here.
DATABASE_URL=
NEON_BRANCH=

# Better Auth (lib/auth.ts). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Neon Object Storage, filled by `neon env pull` when a bucket is declared in neon.ts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=


# Polar (payments). Create an org access token in the Polar dashboard.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Resend (transactional email for OTP sign-in and password reset).
# From address must be a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=noreply@tshono.lubasiverse.com

# Umami analytics. Defaults to the self-hosted instance below; override the id
# with an empty string to send nothing. Dev never loads the script.
NUXT_PUBLIC_UMAMI_SRC=https://analytics.lubasiverse.com/script.js
NUXT_PUBLIC_UMAMI_ID=a7029343-142f-456f-81d3-d7069bf68106
